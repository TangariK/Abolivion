# Local only — never commit real secrets (.env is gitignored).
#
# DATABASE_URL / SUPABASE_SECRET_KEY → scripts/admin only (server-side).
# Game client needs ONLY:
#   VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (publishable)

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional. Do NOT prefix with VITE_ — secrets must never ship to the browser.
# SUPABASE_SECRET_KEY=sb_secret_...

# Brevo — só para deploy da Edge Function (npm run functions:deploy).
# NÃO vão para o Vite. BREVO_MCP_KEY não é usada pelo jogo — pode apagar.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER=seu-remetente-verificado@email.com
# BREVO_SENDER_NAME=Abolivion

# Freesound — só scripts locais (npm run audio:fetch). NUNCA VITE_.
# FREESOUND_API_KEY=
# FREESOUND_CLIENT_ID=
